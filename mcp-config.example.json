{
  "mcpServers": {
    "mcd-mcp": {
      "type": "streamablehttp",
      "url": "https://mcp.mcd.cn",
      "headers": {"Authorization": "Bearer ${MCD_MCP_TOKEN}"}
    },
    "mcreplay-capture": {
      "command": "${MCREPLAY_EXECUTABLE}",
      "args": ["capture", "--out", "${MCREPLAY_CAPTURE_PATH}"]
    }
  }
}
